#include <windows.h>
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//
IDI_APPLET ICON "i2cctrl.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Manifest
//
1 RT_MANIFEST "i2cctrl_helper.manifest"

/////////////////////////////////////////////////////////////////////////////
//
// String Table
//
STRINGTABLE
BEGIN
    IDS_NAME         "I2C Controller Helper"
    IDS_INFO         "Configure I2C controller arbitration, speed, wake, and diagnostics"
    IDS_ERR_REGREAD  "Error reading registry settings"
    IDS_ERR_REGWRITE "Error writing registry settings"
    IDS_OK_APPLY     "Settings applied successfully"
    IDS_ABOUT_TITLE  "About I2C Controller Helper"
    IDS_ABOUT_TEXT   "I2C Controller Helper\nVersion 1.0.0.0\n\nUsefulAGKHelper © 2025\n\nThis applet configures I2C controller features."
END

/////////////////////////////////////////////////////////////////////////////
//
// Accelerator Table
//
IDR_ACCELERATOR ACCELERATORS
BEGIN
    VK_RETURN, IDOK,      VIRTKEY, NOINVERT
    VK_ESCAPE, IDCANCEL,  VIRTKEY, NOINVERT
    VK_F1,     IDM_ABOUT, VIRTKEY, NOINVERT
END

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//
IDR_MENU MENU
BEGIN
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...", IDM_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialogs
//
IDD_DIALOG DIALOGEX 0, 0, 300, 210
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "I2C Controller Helper"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Configure I2C Controller Settings", IDC_STATIC, 10, 10, 280, 10

    GROUPBOX "Bus Speed", IDC_STATIC, 10, 30, 280, 40
    COMBOBOX IDC_BUSSPEED, 20, 45, 120, 60,
             CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX "Arbitration", IDC_STATIC, 10, 75, 280, 70
    CONTROL "Enable Multi-Master Arbitration", IDC_ARB_ENABLE, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 20, 90, 200, 10
    LTEXT "Base (µs):", IDC_STATIC, 20, 105, 50, 10
    EDITTEXT IDC_ARB_BASE, 75, 103, 40, 12, ES_NUMBER | WS_TABSTOP
    LTEXT "Max (µs):", IDC_STATIC, 125, 105, 50, 10
    EDITTEXT IDC_ARB_MAX, 175, 103, 40, 12, ES_NUMBER | WS_TABSTOP
    LTEXT "Jitter (µs):", IDC_STATIC, 20, 120, 50, 10
    EDITTEXT IDC_ARB_JITTER, 75, 118, 40, 12, ES_NUMBER | WS_TABSTOP

    CONTROL "Wake from D3", IDC_WAKECAPABLE, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 20, 150, 200, 10

    CONTROL "Force Crash on Error", IDC_FORCECRASH, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 20, 165, 200, 10

    DEFPUSHBUTTON "OK",     IDOK,     160, 185, 50, 14
    PUSHBUTTON    "Cancel", IDCANCEL,220, 185, 50, 14
END

/////////////////////////////////////////////////////////////////////////////
//
// About Box
//
IDD_ABOUTBOX DIALOGEX 0, 0, 200, 120
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About I2C Controller Helper"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON IDI_APPLET, IDC_STATIC, 10, 10, 20, 20
    LTEXT "I2C Controller Helper\nVersion 1.0.0.0\nUsefulAGKHelper © 2025",
          IDC_STATIC, 40, 10, 150, 40
    DEFPUSHBUTTON "OK", IDOK, 75, 90, 50, 14
END
