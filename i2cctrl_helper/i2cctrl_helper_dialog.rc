#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ROM)
LANGUAGE LANG_ROMANIAN, SUBLANG_DEFAULT
#pragma code_page(1250)

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APPLET              ICON                    "i2cctrl.ico"


/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//

1                       RT_MANIFEST             "i2cctrl_helper.manifest"


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_ACCELERATOR ACCELERATORS
BEGIN
    VK_RETURN,      IDOK,                   VIRTKEY, NOINVERT
    VK_ESCAPE,      IDCANCEL,               VIRTKEY, NOINVERT
    VK_F1,          IDM_ABOUT,              VIRTKEY, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU MENU
BEGIN
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...",                   IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_DIALOG DIALOGEX 0, 0, 300, 210
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "I2C Controller Helper"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Configure I2C Controller Settings",IDC_STATIC,10,10,280,10
    GROUPBOX        "Bus Speed",IDC_STATIC,10,30,280,40
    COMBOBOX        IDC_BUSSPEED,20,45,120,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Arbitration",IDC_STATIC,10,75,280,70
    CONTROL         "Enable Multi-Master Arbitration",IDC_ARB_ENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,90,200,10
    LTEXT           "Base (µs):",IDC_STATIC,20,105,50,10
    EDITTEXT        IDC_ARB_BASE,74,100,40,12,ES_NUMBER
    LTEXT           "Max (µs):",IDC_STATIC,125,105,50,10
    EDITTEXT        IDC_ARB_MAX,175,103,40,12,ES_NUMBER
    LTEXT           "Jitter (µs):",IDC_STATIC,20,120,50,10
    EDITTEXT        IDC_ARB_JITTER,75,118,40,12,ES_NUMBER
    CONTROL         "Wake from D3",IDC_WAKECAPABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,150,200,10
    CONTROL         "Force Crash on Error",IDC_FORCECRASH,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,20,165,200,10
    DEFPUSHBUTTON   "OK",IDOK,160,185,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,220,185,50,14
END

IDD_ABOUTBOX DIALOGEX 0, 0, 200, 120
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About I2C Controller Helper"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_APPLET,IDC_STATIC,10,10,20,20
    LTEXT           "I2C Controller Helper\nVersion 1.0.0.0\nUsefulAGKHelper © 2025",IDC_STATIC,40,10,150,40
    DEFPUSHBUTTON   "OK",IDOK,75,90,50,14
END


