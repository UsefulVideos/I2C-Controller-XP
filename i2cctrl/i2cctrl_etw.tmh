/* i2cctrl_etw.tmh
 * Manual WPP/ETW tracing surface (no automatic .tmh generation).
 * Provides flag/level filtering and a TraceEvents front-end that calls
 * a driver-owned ETW write routine while remaining XP/2003-friendly.
 * Genericized: emphasizes abstract bus context (address, speed, timing).
 */

#pragma once
#include <ntddk.h>
#include "i2cctrl_sal.h"   // SAL stubs for XP builds

/* ---------------------------------------------------------------------------
   Trace flags (normally generated by WPP)
   NOTE: TRACE_FLAG_INIT stays defined in i2cctrl_etw.h to avoid redefs.
   --------------------------------------------------------------------------- */
#define TRACE_FLAG_PNP        0x00000002
#define TRACE_FLAG_POWER      0x00000004
#define TRACE_FLAG_IOCTL      0x00000008
#define TRACE_FLAG_BUS        0x00000010
#define TRACE_FLAG_TRANSFER   0x00000020
#define TRACE_FLAG_ISR        0x00000040
#define TRACE_FLAG_DPC        0x00000080
#define TRACE_FLAG_ACPI       0x00000100
#define TRACE_FLAG_SNAPSHOT   0x00000200
#define TRACE_FLAG_HW         0x00000400

/* ---------------------------------------------------------------------------
   Map TRACE_LEVEL_* to DPFLTR levels for DbgPrintEx
   --------------------------------------------------------------------------- */
#ifndef TRACE_LEVEL_CRITICAL
#define TRACE_LEVEL_CRITICAL    DPFLTR_ERROR_LEVEL
#endif
#ifndef TRACE_LEVEL_ERROR
#define TRACE_LEVEL_ERROR       DPFLTR_ERROR_LEVEL
#endif
#ifndef TRACE_LEVEL_WARNING
#define TRACE_LEVEL_WARNING     DPFLTR_WARNING_LEVEL
#endif
#ifndef TRACE_LEVEL_INFORMATION
#define TRACE_LEVEL_INFORMATION DPFLTR_INFO_LEVEL
#endif
#ifndef TRACE_LEVEL_VERBOSE
#define TRACE_LEVEL_VERBOSE     DPFLTR_TRACE_LEVEL
#endif

#ifdef __cplusplus
extern "C" {
#endif

/* ---------------------------------------------------------------------------
   Provider state (defined in your .c file)
   --------------------------------------------------------------------------- */
extern volatile ULONG g_I2cCtrlTraceEnableMask;   /* bitmask for TRACE_FLAG_* */
extern volatile UCHAR g_I2cCtrlMinLevelTable[32]; /* per-flag minimum level */
extern PVOID g_I2cCtrlEtwRegHandle;               /* ETW provider handle */

/* ---------------------------------------------------------------------------
   Front-end writer implemented in your .c file
   --------------------------------------------------------------------------- */
VOID
I2cCtrlEtwWrite(
    _In_ UCHAR Level,
    _In_ ULONG Flags,
    _In_z_ const char* Msg,
    ...
    );

#ifdef __cplusplus
}
#endif

/* ---------------------------------------------------------------------------
   Helper: resolve first-set-bit index (0..31) for per-flag level gating
   --------------------------------------------------------------------------- */
__forceinline
ULONG
I2cCtrlFlagIndex(ULONG Flags)
{
    ULONG i;
    for (i = 0; i < 32; ++i) {
        if (Flags & (1UL << i)) {
            return i;
        }
    }
    return 0; /* default if none; callers should pass a single flag */
}

/* ---------------------------------------------------------------------------
   WPP-style macros: logger hook and enabled checks
   --------------------------------------------------------------------------- */
#define WPP_LEVEL_LOGGER(level)  (DPFLTR_IHVDRIVER_ID)
#define WPP_LEVEL_ENABLED(level) (TRUE)

#ifndef WPP_FLAG_LEVEL_ENABLED
#define WPP_FLAG_LEVEL_LOGGER(flag, level) WPP_LEVEL_LOGGER(level)
#define WPP_FLAG_LEVEL_ENABLED(flag, level)                                      \
    ( ((g_I2cCtrlTraceEnableMask & (flag)) != 0) &&                              \
      (g_I2cCtrlMinLevelTable[I2cCtrlFlagIndex(flag)] <= (UCHAR)(level)) )
#endif

/* ---------------------------------------------------------------------------
   TraceEvents front-end
   Filters by enable mask and per-flag minimum level, then calls writer.
   --------------------------------------------------------------------------- */
#ifndef TraceEvents
#define TraceEvents(Level, Flags, Msg, ...)                                      \
    do {                                                                         \
        if (WPP_FLAG_LEVEL_ENABLED((Flags), (Level))) {                          \
            I2cCtrlEtwWrite((UCHAR)(Level), (ULONG)(Flags), (Msg), __VA_ARGS__); \
        }                                                                        \
    } while (0)
#endif
