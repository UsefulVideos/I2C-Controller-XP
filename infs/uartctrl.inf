[uartctrl_Install.NTx86]
CopyFiles     = uartctrl.CopyFiles
AddReg        = uartctrl.AddReg.NTx86
ServiceInstall= uartctrl_Service

[uartctrl_Install.NTamd64]
CopyFiles     = uartctrl.CopyFiles
AddReg        = uartctrl.AddReg.NTamd64
ServiceInstall= uartctrl_Service


[uartctrl.CopyFiles]
uartctrl.sys

[uartctrl.AddReg.NTx86]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,uartctrl.sys

[uartctrl.AddReg.NTamd64]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,uartctrl.sys

[uartctrl_Service]
DisplayName   = %uartctrl.ServiceDesc%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\uartctrl.sys

; -----------------------------------------------------------------------
; Right-click installation support
; -----------------------------------------------------------------------
[DefaultInstall]
CopyFiles     = uartctrl.CopyFiles
AddReg        = uartctrl.AddReg
ServiceInstall= uartctrl_Service

[DefaultInstall.Services]
AddService = uartctrl,0,uartctrl_Service

[Strings]
ManufacturerName     = "UsefulAGKHelper"
uartctrl.DeviceDesc  = "UART Controller Driver"
uartctrl.ServiceDesc = "UART Controller Service"
DiskName             = "UART Controller Installation Files"
