[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
DriverVer   = 11/13/2025,1.0.0.0

[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%ManufacturerName% = UsefulAGKHelper, NTx86, NTamd64

