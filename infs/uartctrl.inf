[uartctrl_Install]
CopyFiles = Drivers_Copy

[uartctrl_Install.Services]
AddService = uartctrl, 0x00000002, uartctrl_Service

[uartctrl_Service]
DisplayName   = %uartctrl.ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\uartctrl.sys
LoadOrderGroup = Base

; =====================================================================
;  DEFAULT INSTALL (right‑click → Install)
; =====================================================================

[DefaultInstall]
CopyFiles = Drivers_Copy

[DefaultInstall.Services]
AddService = uartctrl, 0x00000002, uartctrl_Service

; =====================================================================
;  FILE COPY + DISK INFO
; =====================================================================

[Drivers_Copy]
uartctrl.sys

[DestinationDirs]
Drivers_Copy = 12   ; %SystemRoot%\System32\drivers

[SourceDisksFiles]
uartctrl.sys = 1

[SourceDisksNames]
1 = %DiskName%,,,.

; =====================================================================
;  STRINGS
; =====================================================================

[Strings]
ManufacturerName     = "UsefulAGKHelper"
uartctrl.DeviceDesc  = "UART Controller Driver"
uartctrl.ServiceDesc = "UART Controller Service"
DiskName             = "UART Controller Installation Files"
