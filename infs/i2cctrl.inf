 i2cctrl.inf
; Standard I2C Host Controller Bus Driver (i2cctrl.sys)
; Windows XP / Server 2003 (x86/x64)

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %MfgName%
DriverVer   = 12/01/2025,1.0.0.0

[Manufacturer]
%MfgName% = UsefulAGKHelper, NTx86, NTamd64

[ControlFlags]
ExcludeFromSelect = *

; =====================================================================
;  HARDWARE IDs — XP/2003 SUPPORTED CONTROLLERS
; =====================================================================

[UsefulAGKHelper.NTx86]   ; Windows XP / 2003 x86
