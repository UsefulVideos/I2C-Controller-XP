; =====================================================================
;  INSTALL SECTION — BUS DRIVER
; =====================================================================

[I2CCTRL_Inst]
CopyFiles = Drivers_Copy
CopyFiles = Cpl_Copy
AddReg    = I2CCTRL_AddReg

[I2CCTRL_Inst.Services]
AddService = i2cctrl, 0x00000002, I2CCTRL_Service_Inst, I2CCTRL_EventLog_Inst

[I2CCTRL_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\i2cctrl.sys
ImagePath      = \SystemRoot\System32\drivers\i2cctrl.sys
LoadOrderGroup = Base

[I2CCTRL_EventLog_Inst]
AddReg = I2CCTRL_EventLog_AddReg

[I2CCTRL_EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%SystemRoot%\System32\IoLogMsg.dll;%SystemRoot%\System32\drivers\i2cctrl.sys"
HKR,,TypesSupported,0x00010001,7

[I2CCTRL_AddReg]

; -------------------------
; Hardware Quirks (original)
; -------------------------
HKR,,"Quirk.ResetWorkaround",0x00010001,1
HKR,,"Quirk.ClockGate",0x00010001,1
HKR,,"Quirk.NoDma",0x00010001,1

; -------------------------
; UI-driven settings (new)
; -------------------------
HKR,,"WakeCapable",0x00010001,0
HKR,,"MultiMasterEnabled",0x00010001,1
HKR,,"ArbBackoffBaseUs",0x00010001,100
HKR,,"ArbBackoffMaxUs",0x00010001,5000
HKR,,"ArbBackoffJitterUs",0x00010001,50
HKR,,"ForceCrashOnError",0x00010001,0

; -------------------------
; INF-driven policy overrides (original names preserved)
; -------------------------
HKR,,"Policy.BusSpeedHz",0x00010001,400000
HKR,,"Policy.MaxRetries",0x00010001,3
HKR,,"Policy.TransactionTimeoutMs",0x00010001,1000
HKR,,"Policy.BackoffInitialUs",0x00010001,10
HKR,,"Policy.BackoffMaxUs",0x00010001,5000
HKR,,"Policy.UsePec",0x00010001,0
HKR,,"Policy.Force10BitAddr",0x00010001,0


; =====================================================================
;  DEFAULT INSTALL (right‑click → Install)
; =====================================================================

[DefaultInstall]
CopyFiles = Drivers_Copy
CopyFiles = Cpl_Copy
AddReg    = I2CCTRL_AddReg

[DefaultInstall.Services]
AddService = i2cctrl, 0x00000002, I2CCTRL_Service_Inst, I2CCTRL_EventLog_Inst

; =====================================================================
;  FILE COPY + DISK INFO
; =====================================================================

[Drivers_Copy]
i2cctrl.sys

[Cpl_Copy]
i2cctrl_helper.cpl

[DestinationDirs]
Drivers_Copy = 12   ; %SystemRoot%\System32\drivers

[DestinationDirs.NTx86]
Cpl_Copy     = 11 ; %SystemRoot%\System32

[DestinationDirs.NTamd64]
Cpl_Copy     = 16422 ; %SystemRoot%\SysWOW64


[SourceDisksFiles]
i2cctrl.sys = 1
i2cctrl_helper.cpl   = 1

[SourceDisksNames]
1 = %DiskName%,,,.

; =====================================================================
;  STRINGS
; =====================================================================

[Strings]
MfgName           = "UsefulAGKHelper"
I2CControllerDesc = "Standard I2C Host Controller Bus Driver"
ServiceDesc       = "Standard I2C Host Controller Service"
DiskName          = "Standard I2C Host Controller Driver Disk"
