; i2chid.inf
; Installation script for the HID‑over‑I²C Miniport Driver (i2chid.sys)
; Provides HID miniport support for I²C HID Touchpad devices
; Manufacturer: UsefulAGKHelper
; Supported Platforms: Windows XP (5.1, x86),
;                      Windows Server 2003 (5.2, x86/x64),
;                      Windows XP Professional x64 Edition (5.2, amd64)

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider    = %MfgName%
DriverVer   = 11/08/2025,1.0.0.0

[Manufacturer]
%MfgName% = UsefulAGKHelper,NTx86.5.1,NTx86.5.2,NTamd64.5.2

; ---------------- Hardware IDs ----------------

[UsefulAGKHelper.NTx86.5.1]   ; Windows XP 32‑bit
%DeviceDesc% = I2CHID_Inst, ACPI\PNP0C50

[UsefulAGKHelper.NTx86.5.2]   ; Windows Server 2003 32‑bit
%DeviceDesc% = I2CHID_Inst, ACPI\PNP0C50

[UsefulAGKHelper.NTamd64.5.2] ; Windows XP x64 / Server 2003 x64
%DeviceDesc% = I2CHID_Inst, ACPI\PNP0C50

; ---------------- Install Section ----------------

[I2CHID_Inst]
CopyFiles   = Drivers_Copy
AddReg      = I2CHID_AddReg

[I2CHID_Inst.Services]
AddService  = i2chid, 0x00000002, I2CHID_Service_Inst, I2CHID_EventLog_Inst

; ---------------- Service Definition ----------------

[I2CHID_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1   ; SERVICE_KERNEL_DRIVER
StartType      = 3   ; SERVICE_DEMAND_START
ErrorControl   = 1   ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\i2chid.sys
LoadOrderGroup = Base

[I2CHID_EventLog_Inst]
AddReg = I2CHID_EventLog_AddReg

[I2CHID_EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%SystemRoot%\System32\IoLogMsg.dll;%SystemRoot%\System32\drivers\i2chid.sys"
HKR,,TypesSupported,0x00010001,7

; ---------------- Registry Settings ----------------

[I2CHID_AddReg]
; Default tunables read by I2CHID_LoadRegistryConfig
HKR,,"Cfg.PollIntervalMs",0x00010001,8
HKR,,"PalmThreshold",0x00010001,10
HKR,,"ScrollScale",0x00010001,1
HKR,,"TapTimeMs",0x00010001,180

; ---------------- Files, Destinations, Sources ----------------

[Drivers_Copy]
i2chid.sys

[DestinationDirs]
Drivers_Copy = 12    ; %SystemRoot%\System32\drivers

[SourceDisksFiles]
i2chid.sys = 1

[SourceDisksNames]
1 = %DiskName%,,,.

; ---------------- Strings ----------------

[Strings]
MfgName     = "UsefulAGKHelper"
DeviceDesc  = "HID‑over‑I²C Touchpad"
ServiceDesc = "HID‑over‑I²C Miniport Service"
DiskName    = "HID‑over‑I²C Driver Disk"
