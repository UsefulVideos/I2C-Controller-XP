[Version]
Signature   = "$Windows NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
DriverVer   = 11/09/2025, 1.0.0.0

[ControlFlags]
ExcludeFromSelect = *

[Manufacturer]
%ManufacturerName% = Models, NTx86.5.1, NTx86.5.2, NTamd64.5.2

; Windows XP 32-bit
[Models.NTx86.5.1]
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\INT3450
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\INT3451
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\AMD0030
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\NVDA0100
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\NVDA0200
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\VIA0008
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\BRCM0100
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\QCOM0001
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\SYN0001
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\TI0001
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_9D35
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_9D36
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_9D37
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A123
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A124
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A2F0
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A2F1
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A2F2
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A2F3

; Windows Server 2003 32-bit
[Models.NTx86.5.2]
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\INT3450
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\INT3451
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\AMD0030
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\NVDA0100
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\NVDA0200
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\VIA0008
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\BRCM0100
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\QCOM0001
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\SYN0001
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\TI0001
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_9D35
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_9D36
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_9D37
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A123
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A124
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A2F0
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A2F1
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A2F2
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_A2F3

; Windows XP/2003 x64
[Models.NTamd64.5.2]
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\INT3450
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\INT3451
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\AMD0030
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\NVDA0100
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\NVDA0200
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\VIA0008
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\BRCM0100
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\QCOM0001
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\SYN0001
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, ACPI\TI0001
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_9D35
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_9D36
%GpioCtrl.DeviceDesc% = GpioCtrl_Install, PCI\VEN_8086&DEV_9D37
